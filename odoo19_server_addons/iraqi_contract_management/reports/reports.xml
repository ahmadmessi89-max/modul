<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Direct Supply Contract Summary Report -->
    <record id="action_report_direct_supply_contract" model="ir.actions.report">
        <field name="name">تقرير ملخص عقد التجهيز والمقاولة</field>
        <field name="model">direct.supply.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">iraqi_contract_management.report_direct_contract_template</field>
        <field name="report_file">iraqi_contract_management.report_direct_contract_template</field>
        <field name="print_report_name">'عقد تجهيز مباشر - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_direct_supply_contract"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 2. Financial Cost Breakdown & Guarantees Report -->
    <record id="action_report_direct_contract_financial" model="ir.actions.report">
        <field name="name">كشف المطابقة المالية والضمانات والغرامات</field>
        <field name="model">direct.supply.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">iraqi_contract_management.report_direct_contract_financial_template</field>
        <field name="report_file">iraqi_contract_management.report_direct_contract_financial_template</field>
        <field name="print_report_name">'المطابقة المالية للعقد - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_direct_supply_contract"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 3. Handover & Warranty Acceptance Report -->
    <record id="action_report_direct_contract_handover" model="ir.actions.report">
        <field name="name">محضر الاستلام الأولي والنهائي والضمان</field>
        <field name="model">direct.supply.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">iraqi_contract_management.report_direct_contract_handover_template</field>
        <field name="report_file">iraqi_contract_management.report_direct_contract_handover_template</field>
        <field name="print_report_name">'محضر استلام عقد - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_direct_supply_contract"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
