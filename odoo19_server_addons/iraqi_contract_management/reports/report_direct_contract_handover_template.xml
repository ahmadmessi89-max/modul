<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_direct_contract_handover_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl" style="font-family: 'Cairo', 'DejaVu Sans', sans-serif; font-size: 13px;">
                        <div class="text-center mb-4 pb-2 border-bottom">
                            <h2 style="color: #2c5282; font-weight: bold;">محضر الاستلام الأولي والنهائي والضمان</h2>
                            <h4 style="color: #4a5568;">عقد تجهيز ومقاولة رقم: <span t-field="doc.contract_number"/> (<span t-field="doc.name"/>)</h4>
                        </div>

                        <!-- Basic Details -->
                        <table class="table table-bordered table-sm mb-4">
                            <tbody>
                                <tr>
                                    <td style="width: 20%; background-color: #edf2f7;"><strong>الجهة المستفيدة:</strong></td>
                                    <td style="width: 30%;"><span t-field="doc.beneficiary_id.name"/></td>
                                    <td style="width: 20%; background-color: #edf2f7;"><strong>الجهة المجهزة (المقاول):</strong></td>
                                    <td style="width: 30%;"><span t-field="doc.vendor_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="background-color: #edf2f7;"><strong>موضوع العقد:</strong></td>
                                    <td colspan="3"><span t-field="doc.contract_subject"/></td>
                                </tr>
                                <tr>
                                    <td style="background-color: #edf2f7;"><strong>تاريخ الاستلام الأولي:</strong></td>
                                    <td><span t-field="doc.provisional_handover_date or doc.actual_delivery_date"/></td>
                                    <td style="background-color: #edf2f7;"><strong>فترة الضمان والصيانة:</strong></td>
                                    <td><span t-field="doc.warranty_period_months"/> شهر</td>
                                </tr>
                                <tr>
                                    <td style="background-color: #edf2f7;"><strong>تاريخ الاستلام النهائي:</strong></td>
                                    <td><span t-field="doc.final_handover_date or 'قيد فترة الصيانة'"/></td>
                                    <td style="background-color: #edf2f7;"><strong>موقف براءة الذمة الضريبية:</strong></td>
                                    <td><span t-field="doc.tax_clearance_status"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Material Inspection Table -->
                        <h4 style="color: #2c5282; border-bottom: 2px solid #2c5282; padding-bottom: 5px;">
                            المواد والأعمال المنجزة والمستلمة موقعياً
                        </h4>
                        <table class="table table-bordered table-striped table-sm text-center mt-2">
                            <thead style="background-color: #2c5282; color: white;">
                                <tr>
                                    <th style="width: 5%;">ت</th>
                                    <th style="width: 45%;">المواصفات الفنية للمادة</th>
                                    <th style="width: 12%;">الكمية التعاقدية</th>
                                    <th style="width: 12%;">الكمية المجهزة</th>
                                    <th style="width: 12%;">الوحدة</th>
                                    <th style="width: 14%;">موقف الفحص والمطابقة</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="1"/>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><t t-esc="idx"/></td>
                                    <td class="text-end"><span t-field="line.name"/></td>
                                    <td><span t-field="line.quantity"/></td>
                                    <td><span t-field="line.delivered_quantity"/></td>
                                    <td><span t-field="line.uom_id.name"/></td>
                                    <td><span t-field="line.delivery_status"/></td>
                                    <t t-set="idx" t-value="idx + 1"/>
                                </tr>
                            </tbody>
                        </table>

                        <div class="alert alert-info mt-4" style="background-color: #ebf8ff; border-color: #bee3f8; color: #2b6cb0;">
                            <strong>إقرار وتوصية لجنة الاستلام والقبول:</strong>
                            نؤيد استلام كافة المواد والأعمال المبينة أعلاه وفق الشروط والمواصفات الفنية المعتمدة، والتوصية بإطلاق المستحقات والكفالات المصرفية بعد استيفاء الشروط القانونية والضريبية.
                        </div>

                        <!-- Committee Signatures -->
                        <div class="row mt-5 text-center">
                            <div class="col-4">
                                <strong>عضو لجنة الاستلام (الفني)</strong><br/><br/>
                                <span>....................................</span>
                            </div>
                            <div class="col-4">
                                <strong>ممثل الجهة المجهزة / المقاول</strong><br/><br/>
                                <span>....................................</span>
                            </div>
                            <div class="col-4">
                                <strong>رئيس لجنة الاستلام والقبول</strong><br/><br/>
                                <span>....................................</span>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
