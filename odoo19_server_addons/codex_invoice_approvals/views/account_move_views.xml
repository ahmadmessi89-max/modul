<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_approvals" model="ir.ui.view">
            <field name="name">account.move.form.inherit.approvals</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']" position="attributes">
                    <attribute name="optional">show</attribute>
                    <attribute name="column_invisible">0</attribute>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="attributes">
                    <attribute name="optional">show</attribute>
                    <attribute name="column_invisible">0</attribute>
                </xpath>

                <xpath expr="//header" position="inside">
                    <field name="is_approvals_enabled" invisible="1"/>

                    <button name="action_request_approval"
                            string="طلب موافقة"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft' or not is_approvals_enabled"/>

                    <button name="action_approve_accountant"
                            string="موافقة المحاسب"
                            type="object"
                            class="oe_highlight"
                            groups="codex_invoice_approvals.group_approval_accountant"
                            invisible="state != 'waiting_accountant' or not is_approvals_enabled"/>

                    <button name="action_approve_financial_manager"
                            string="موافقة المدير المالي"
                            type="object"
                            class="oe_highlight"
                            groups="codex_invoice_approvals.group_approval_financial_manager"
                            invisible="state not in ['waiting_accountant', 'waiting_financial_manager'] or not is_approvals_enabled"/>

                    <button name="action_approve_auditor"
                            string="موافقة المدقق"
                            type="object"
                            class="oe_highlight"
                            groups="codex_invoice_approvals.group_approval_auditor"
                            invisible="state != 'waiting_auditor' or not is_approvals_enabled"/>

                    <button name="action_approve_managing_director"
                            string="موافقة المدير المفوض (اعتماد وترحيل)"
                            type="object"
                            class="oe_highlight"
                            groups="codex_invoice_approvals.group_approval_managing_director"
                            invisible="state != 'waiting_managing_director' or not is_approvals_enabled"/>

                    <button name="action_reject"
                            string="رفض / إعادة للمسودة"
                            type="object"
                            class="btn-danger"
                            groups="codex_invoice_approvals.group_approval_accountant,codex_invoice_approvals.group_approval_financial_manager,codex_invoice_approvals.group_approval_auditor,codex_invoice_approvals.group_approval_managing_director"
                            invisible="state not in ['waiting_accountant', 'waiting_financial_manager', 'waiting_auditor', 'waiting_managing_director']"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
