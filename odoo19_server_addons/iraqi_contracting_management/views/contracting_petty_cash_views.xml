<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Petty Cash List View -->
    <record id="view_contracting_petty_cash_tree" model="ir.ui.view">
        <field name="name">contracting.petty.cash.list</field>
        <field name="model">contracting.petty.cash</field>
        <field name="arch" type="xml">
            <list string="كشوفات السلفة النقدية الموقعية (ذمة المهندس)" decoration-info="state == 'draft'" decoration-warning="state in ('submitted', 'approved')" decoration-success="state == 'settled'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="engineer_id"/>
                <field name="date"/>
                <field name="custody_amount" widget="monetary" sum="إجمالي السلف المسلمة"/>
                <field name="total_spent_amount" widget="monetary" sum="إجمالي المنصرف"/>
                <field name="balance_remaining" widget="monetary" sum="إجمالي المتبقي"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state in ('submitted', 'approved')" decoration-success="state == 'settled'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Petty Cash Form View -->
    <record id="view_contracting_petty_cash_form" model="ir.ui.view">
        <field name="name">contracting.petty.cash.form</field>
        <field name="model">contracting.petty.cash</field>
        <field name="arch" type="xml">
            <form string="كشف سلفة نقدية موقعية (ذمة المهندس)">
                <header>
                    <button name="action_submit" string="تقديم الكشف للمهندس المقيم" type="object" invisible="state != 'draft'" class="btn-primary" groups="iraqi_contracting_management.group_contracting_site_engineer,iraqi_contracting_management.group_contracting_project_manager"/>
                    <button name="action_approve" string="اعتماد فني من المهندس المقيم" type="object" invisible="state != 'submitted'" class="btn-primary" groups="iraqi_contracting_management.group_contracting_project_manager"/>
                    <button name="action_settle" string="تسوية مالية وقيد محاسبي" type="object" invisible="state != 'approved'" class="btn-success" groups="iraqi_contracting_management.group_contracting_financial_auditor,account.group_account_invoice"/>
                    <button name="action_reset_draft" string="إعادة للمسودة" type="object" invisible="state in ('draft', 'settled')" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,settled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="رقم كشف السلفة النقدية"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="بيانات المشروع والمهندس">
                            <field name="project_id" readonly="state == 'settled'"/>
                            <field name="engineer_id" readonly="state == 'settled'"/>
                            <field name="resident_engineer_id" readonly="state == 'settled'"/>
                        </group>
                        <group string="التاريخ وأرصدة العهدة">
                            <field name="date" readonly="state == 'settled'"/>
                            <field name="custody_amount" widget="monetary" readonly="state == 'settled'"/>
                            <field name="total_spent_amount" widget="monetary"/>
                            <field name="balance_remaining" widget="monetary" class="font-weight-bold text-success"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="وصولات ومصروفات السلفة الموقعية" name="receipts">
                            <field name="line_ids" readonly="state == 'settled'">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="receipt_no"/>
                                    <field name="name"/>
                                    <field name="boq_id" domain="[('project_id', '=', parent.project_id)]"/>
                                    <field name="cost_element_id"/>
                                    <field name="amount" widget="monetary" sum="المجموع المنصرف"/>
                                    <field name="receipt_image" widget="binary" filename="name"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <page string="ملاحظات وتفاصيل الكشف" name="notes">
                            <field name="notes" placeholder="ملاحظات إضافية حول المصروفات الموقعية..." readonly="state == 'settled'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Petty Cash Search View -->
    <record id="view_contracting_petty_cash_search" model="ir.ui.view">
        <field name="name">contracting.petty.cash.search</field>
        <field name="model">contracting.petty.cash</field>
        <field name="arch" type="xml">
            <search string="بحث كشوفات السلفة النقدية">
                <field name="name"/>
                <field name="project_id"/>
                <field name="engineer_id"/>
                <field name="resident_engineer_id"/>
                <separator/>
                <filter string="المسودات" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="المقدمة للاعتماد" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="المعتمدة فنياً" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="المسواة محاسبياً" name="settled" domain="[('state', '=', 'settled')]"/>
                <group>
                    <filter string="المشروع" name="group_by_project" domain="[]" context="{'group_by': 'project_id'}"/>
                    <filter string="مهندس الموقع" name="group_by_engineer" domain="[]" context="{'group_by': 'engineer_id'}"/>
                    <filter string="الحالة" name="group_by_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="تاريخ الكشف" name="group_by_date" domain="[]" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_contracting_petty_cash" model="ir.actions.act_window">
        <field name="name">كشوفات السلفة النقدية الموقعية (ذمة المهندس)</field>
        <field name="res_model">contracting.petty.cash</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_contracting_petty_cash_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                سجل أول كشف تسوية لسلفة نقدية موقعية (ذمة المهندس) مع إرفاق صور الوصولات!
            </p>
        </field>
    </record>
</odoo>
