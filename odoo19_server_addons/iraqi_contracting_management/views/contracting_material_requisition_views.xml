<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Material Requisition List View -->
    <record id="view_contracting_material_requisition_list" model="ir.ui.view">
        <field name="name">contracting.material.requisition.list</field>
        <field name="model">contracting.material.requisition</field>
        <field name="arch" type="xml">
            <list string="أذونات صرف المواد للمشاريع">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="site_engineer_id"/>
                <field name="warehouse_id"/>
                <field name="residential_unit_id"/>
                <field name="total_cost" widget="monetary" sum="إجمالي التكلفة"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-primary="state == 'approved'" decoration-success="state == 'issued'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Material Requisition Form View -->
    <record id="view_contracting_material_requisition_form" model="ir.ui.view">
        <field name="name">contracting.material.requisition.form</field>
        <field name="model">contracting.material.requisition</field>
        <field name="arch" type="xml">
            <form string="إذن صرف مواد موقعية">
                <header>
                    <button name="action_submit" string="تقديم للاعتماد" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="مصادقة المهندس المقيم" type="object" class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_issue" string="صرف مخزني وترحيل للتكلفة" type="object" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="إلغاء الإذن" type="object" invisible="state in ['issued', 'cancelled']"/>
                    <button name="action_reset_draft" string="إعادة للمسودة" type="object" invisible="state not in ['submitted', 'approved', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,issued"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="رقم إذن الصرف"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="المشروع والموقع">
                            <field name="project_id"/>
                            <field name="date"/>
                            <field name="site_engineer_id"/>
                            <field name="resident_engineer_id"/>
                            <field name="residential_unit_id"/>
                        </group>
                        <group string="بيانات المخزن والربط المخزني">
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="picking_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="purpose_notes" placeholder="بيان الغرض ومكان التنفيذ الدقيق في الموقع..."/>
                    </group>
                    <notebook>
                        <page string="المواد المطلوب صرفها وبنود الـ BOQ" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="boq_id"/>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="requested_qty"/>
                                    <field name="issued_qty"/>
                                    <field name="unit_cost" widget="monetary"/>
                                    <field name="subtotal" widget="monetary" sum="الإجمالي"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_cost" widget="monetary" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Material Requisition Action -->
    <record id="action_contracting_material_requisition" model="ir.actions.act_window">
        <field name="name">أذونات صرف المواد للمشاريع</field>
        <field name="res_model">contracting.material.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                قم بإنشاء أول إذن صرف مواد من المخزن وتحميله على بنود جدول الكميات!
            </p>
        </field>
    </record>
</odoo>
