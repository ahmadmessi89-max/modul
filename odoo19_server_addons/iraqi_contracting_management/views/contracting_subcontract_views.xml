<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subcontract Agreement List View -->
    <record id="view_contracting_subcontract_agreement_list" model="ir.ui.view">
        <field name="name">contracting.subcontract.agreement.list</field>
        <field name="model">contracting.subcontract.agreement</field>
        <field name="arch" type="xml">
            <list string="عقود مقاولي الباطن">
                <field name="name"/>
                <field name="title"/>
                <field name="subcontractor_id"/>
                <field name="project_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="contract_amount" widget="monetary" sum="إجمالي العقود"/>
                <field name="total_executed_amount" widget="monetary" sum="إجمالي المنفذ"/>
                <field name="remaining_balance" widget="monetary" sum="المتبقي"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'confirmed'" decoration-success="state in ['in_progress', 'completed']" decoration-danger="state == 'terminated'"/>
            </list>
        </field>
    </record>

    <!-- Subcontract Agreement Form View -->
    <record id="view_contracting_subcontract_agreement_form" model="ir.ui.view">
        <field name="name">contracting.subcontract.agreement.form</field>
        <field name="model">contracting.subcontract.agreement</field>
        <field name="arch" type="xml">
            <form string="عقد مقاولة باطن">
                <header>
                    <button name="action_confirm" string="اعتماد وتوقيع العقد" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" string="إصدار أمر المباشرة" type="object" class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_complete" string="إنجاز وتسليم نهائي" type="object" class="btn-info" invisible="state != 'in_progress'"/>
                    <button name="action_terminate" string="فسخ العقد" type="object" class="btn-danger" invisible="state in ['completed', 'terminated']"/>
                    <button name="action_reset_draft" string="إعادة للمسودة" type="object" invisible="state not in ['confirmed', 'terminated']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_ipcs" type="object" class="oe_stat_button" icon="fa-calculator">
                            <field name="ipc_count" string="الذرعات والسلف" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="رقم العقد التسلسلي"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <label for="title" string="موضوع وعنوان المقاولة"/>
                        <h2><field name="title" placeholder="مثال: تنفيذ أعمال الهياكل الخرسانية للبلوك A"/></h2>
                    </div>
                    <group>
                        <group string="أطراف العقد والمشروع">
                            <field name="project_id"/>
                            <field name="subcontractor_id"/>
                            <field name="contract_ref" placeholder="رقم كتاب الإحالة أو العقد الورقي"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="المدد والتواريخ العقدية">
                            <field name="date_signed"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="contract_duration_days"/>
                        </group>
                    </group>
                    <group>
                        <group string="الشروط المالية والاستقطاعات">
                            <field name="advance_payment_amount" widget="monetary"/>
                            <field name="advance_recovery_rate"/>
                            <field name="retention_rate"/>
                            <field name="tax_deduction_rate"/>
                        </group>
                        <group string="خطابات الضمان المصرفية (الكفالات)">
                            <field name="performance_bond_ref"/>
                            <field name="performance_bond_bank"/>
                            <field name="performance_bond_expiry"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="بنود أعمال المقاولة المسعرة" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="boq_id"/>
                                    <field name="item_no"/>
                                    <field name="name"/>
                                    <field name="uom_id"/>
                                    <field name="agreed_qty"/>
                                    <field name="subcontract_unit_price" widget="monetary"/>
                                    <field name="subtotal" widget="monetary" sum="الإجمالي"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="contract_amount" widget="monetary"/>
                                <field name="total_executed_amount" widget="monetary"/>
                                <field name="remaining_balance" widget="monetary" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="شروط والتزامات العقد" name="notes">
                            <field name="notes" placeholder="الشروط الجزائية، غرامات التأخير، المواصفات الفنية الخاصة..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Subcontract Agreement Action -->
    <record id="action_contracting_subcontract_agreement" model="ir.actions.act_window">
        <field name="name">عقود مقاولي الباطن</field>
        <field name="res_model">contracting.subcontract.agreement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                قم بإنشاء أول عقد لمقاول باطن بأسعاره المستقلة ونسب استقطاعاته!
            </p>
        </field>
    </record>
</odoo>
