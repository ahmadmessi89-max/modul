<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_boq_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article doc_report_layout_standard" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" dir="rtl" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 12px; color: #222;">
                    
                    <!-- Header -->
                    <div style="border-bottom: 2px solid #1a3a5f; padding-bottom: 10px; margin-bottom: 15px;">
                        <table style="width: 100%; text-align: center;">
                            <tr>
                                <td style="width: 30%; text-align: right; vertical-align: middle;">
                                    <h4 style="margin: 0; color: #1a3a5f; font-weight: bold;"><span t-field="o.company_id.name"/></h4>
                                    <p style="margin: 2px 0 0 0; font-size: 11px; color: #555;">دائرة العطاءات وجداول الكميات</p>
                                </td>
                                <td style="width: 40%; text-align: center; vertical-align: middle;">
                                    <h2 style="margin: 0; color: #1a3a5f; font-weight: bold; font-size: 20px;">جدول الكميات والتسعير المعتمد</h2>
                                    <h4 style="margin: 4px 0 0 0; color: #444; font-size: 14px;">Bill of Quantities (BOQ / WBS)</h4>
                                </td>
                                <td style="width: 30%; text-align: left; vertical-align: middle;">
                                    <p style="margin: 0; font-weight: bold; font-size: 13px; color: #1a3a5f;">المشروع: <span t-field="o.name"/></p>
                                    <p style="margin: 2px 0 0 0; font-size: 12px;">العقد: <span t-field="o.contract_ref"/></p>
                                    <p style="margin: 2px 0 0 0; font-size: 11px;">العملة: <span t-field="o.currency_id.name"/></p>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Contract Valuation Summary -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 11px; background-color: #f8f9fa; border: 1px solid #dee2e6;">
                        <tr>
                            <td style="padding: 6px; border: 1px solid #dee2e6; width: 25%; font-weight: bold; color: #1a3a5f;">قيمة العقد الأصلية:</td>
                            <td style="padding: 6px; border: 1px solid #dee2e6; width: 25%;"><span t-field="o.contract_value_tender" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                            <td style="padding: 6px; border: 1px solid #dee2e6; width: 25%; font-weight: bold; color: #1a3a5f;">أوامر الغيار المصادق عليها:</td>
                            <td style="padding: 6px; border: 1px solid #dee2e6; width: 25%;"><span t-field="o.vo_total_revenue" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 6px; border: 1px solid #dee2e6; font-weight: bold; color: #1a3a5f;">قيمة العقد الحالية المعدلة:</td>
                            <td style="padding: 6px; border: 1px solid #dee2e6; font-weight: bold; color: #2e6da4;"><span t-field="o.contract_value_current" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                            <td style="padding: 6px; border: 1px solid #dee2e6; font-weight: bold; color: #1a3a5f;">إجمالي موازنة التكلفة التقديرية:</td>
                            <td style="padding: 6px; border: 1px solid #dee2e6; font-weight: bold;"><span t-field="o.total_boq_estimated_budget" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                        </tr>
                    </table>

                    <!-- BOQ Lines Table -->
                    <table style="width: 100%; border-collapse: collapse; font-size: 10px; margin-bottom: 15px; border: 1px solid #333;">
                        <thead>
                            <tr style="background-color: #1a3a5f; color: #ffffff; text-align: center;">
                                <th style="border: 1px solid #444; padding: 5px; width: 6%;">رقم البند</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 14%;">حزمة العمل</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 30%;">وصف الفقرة والمواصفات الفنية</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 6%;">الوحدة</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 8%;">الكمية الأصلية</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 8%;">أوامر الغيار</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 8%;">الكمية المعدلة</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 9%;">سعر الوحدة</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 11%;">الإجمالي المعتمد</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.boq_line_ids" t-as="line" style="text-align: center; page-break-inside: avoid;">
                                <td style="border: 1px solid #ccc; padding: 4px; font-weight: bold;"><span t-field="line.item_no"/></td>
                                <td style="border: 1px solid #ccc; padding: 4px; text-align: right;"><span t-field="line.package_id.name"/></td>
                                <td style="border: 1px solid #ccc; padding: 4px; text-align: right;"><span t-field="line.name"/></td>
                                <td style="border: 1px solid #ccc; padding: 4px;"><span t-field="line.uom_id.name"/></td>
                                <td style="border: 1px solid #ccc; padding: 4px;"><span t-esc="'{:,.2f}'.format(line.contract_qty)"/></td>
                                <td style="border: 1px solid #ccc; padding: 4px;"><span t-esc="'{:,.2f}'.format(line.vo_qty)"/></td>
                                <td style="border: 1px solid #ccc; padding: 4px; font-weight: bold;"><span t-esc="'{:,.2f}'.format(line.revised_contract_qty)"/></td>
                                <td style="border: 1px solid #ccc; padding: 4px;"><span t-esc="'{:,.2f}'.format(line.tender_unit_price)"/></td>
                                <td style="border: 1px solid #ccc; padding: 4px; font-weight: bold;"><span t-esc="'{:,.2f}'.format(line.revised_total_amount)"/></td>
                            </tr>
                            <tr style="background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                <td colspan="8" style="border: 1px solid #999; padding: 6px; text-align: left;">المجموع الكلي لجدول الكميات والتسعير:</td>
                                <td style="border: 1px solid #999; padding: 6px;"><span t-field="o.contract_value_current" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Official Signatures -->
                    <div style="margin-top: 30px; page-break-inside: avoid; border-top: 1px solid #999; padding-top: 10px;">
                        <table style="width: 100%; text-align: center; font-size: 11px;">
                            <tr>
                                <td style="width: 33%;">
                                    <p style="font-weight: bold; margin-bottom: 40px;">مهندس التخمين وجداول الكميات</p>
                                    <p style="margin: 0;">التوقيع: ..........................</p>
                                </td>
                                <td style="width: 33%;">
                                    <p style="font-weight: bold; margin-bottom: 40px;">مدير دائرة المشاريع والعقود</p>
                                    <p style="margin: 0;">التوقيع: ..........................</p>
                                </td>
                                <td style="width: 33%;">
                                    <p style="font-weight: bold; margin-bottom: 40px;">المدير المفوض / رئيس مجلس الإدارة</p>
                                    <p style="margin: 0;">التوقيع: ..........................</p>
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
