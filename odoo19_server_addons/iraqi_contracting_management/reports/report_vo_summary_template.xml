<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_vo_summary_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article doc_report_layout_standard" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" dir="rtl" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 11.5px; color: #222;">
                    
                    <!-- Header -->
                    <div style="border-bottom: 2px solid #1a3a5f; padding-bottom: 10px; margin-bottom: 15px;">
                        <table style="width: 100%; text-align: center;">
                            <tr>
                                <td style="width: 30%; text-align: right; vertical-align: middle;">
                                    <h4 style="margin: 0; color: #1a3a5f; font-weight: bold;"><span t-field="o.company_id.name"/></h4>
                                    <p style="margin: 2px 0 0 0; font-size: 11px; color: #555;">دائرة العقود وأوامر التغيير الهندسية</p>
                                </td>
                                <td style="width: 40%; text-align: center; vertical-align: middle;">
                                    <h2 style="margin: 0; color: #1a3a5f; font-weight: bold; font-size: 19px;">كشف موقف أوامر الغيار والمطابقة التعاقدية</h2>
                                    <h4 style="margin: 4px 0 0 0; color: #444; font-size: 13px;">Variation Orders Status &amp; Contract Analysis</h4>
                                </td>
                                <td style="width: 30%; text-align: left; vertical-align: middle;">
                                    <p style="margin: 0; font-weight: bold; font-size: 12px; color: #1a3a5f;">المشروع: <span t-field="o.name"/></p>
                                    <p style="margin: 2px 0 0 0; font-size: 11px;">العقد: <span t-field="o.contract_ref"/></p>
                                    <p style="margin: 2px 0 0 0; font-size: 11px;">التاريخ: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></p>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Contract & VO Summary Box -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 11px; background-color: #f8f9fa; border: 1px solid #dee2e6;">
                        <tr style="text-align: center;">
                            <td style="padding: 6px; border: 1px solid #dee2e6; width: 25%;">
                                <small class="text-muted d-block">قيمة العقد الأصلية / الإحالة</small>
                                <strong style="font-size: 13px; color: #1a3a5f;"><span t-field="o.contract_value_tender" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                            </td>
                            <td style="padding: 6px; border: 1px solid #dee2e6; width: 25%;">
                                <small class="text-muted d-block">صافي أوامر الغيار المصادق عليها</small>
                                <strong style="font-size: 13px; color: #5cb85c;"><span t-field="o.vo_total_revenue" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                            </td>
                            <td style="padding: 6px; border: 1px solid #dee2e6; width: 25%;">
                                <small class="text-muted d-block">قيمة العقد الحالية المعدلة</small>
                                <strong style="font-size: 13px; color: #0275d8;"><span t-field="o.contract_value_current" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong>
                            </td>
                            <td style="padding: 6px; border: 1px solid #dee2e6; width: 25%;">
                                <small class="text-muted d-block">نسبة الزيادة / التغيير على العقد</small>
                                <strong style="font-size: 13px; color: #d9534f;">
                                    <span t-esc="'{:,.2f}%'.format((o.vo_total_revenue / o.contract_value_tender * 100) if o.contract_value_tender > 0 else 0)"/>
                                </strong>
                            </td>
                        </tr>
                    </table>

                    <!-- Variation Orders Detailed Table -->
                    <table style="width: 100%; border-collapse: collapse; font-size: 10.5px; margin-bottom: 15px; border: 1px solid #333;">
                        <thead>
                            <tr style="background-color: #1a3a5f; color: #ffffff; text-align: center;">
                                <th style="border: 1px solid #444; padding: 5px; width: 12%;">رقم أمر الغيار</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 10%;">التاريخ</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 14%;">المهندس المقيم</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 14%;">كتاب مصادقة المالك</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 24%;">الأسباب والمبررات الفنية</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 13%;">الأثر المالي (الإيراد)</th>
                                <th style="border: 1px solid #444; padding: 5px; width: 13%;">حالة الاعتماد</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.variation_order_ids" t-as="vo" style="text-align: center; page-break-inside: avoid;">
                                <td style="border: 1px solid #ccc; padding: 5px; font-weight: bold;"><span t-field="vo.name"/></td>
                                <td style="border: 1px solid #ccc; padding: 5px;"><span t-field="vo.date"/></td>
                                <td style="border: 1px solid #ccc; padding: 5px;"><span t-field="vo.engineer_in_charge_id.name"/></td>
                                <td style="border: 1px solid #ccc; padding: 5px;"><span t-field="vo.client_ref"/></td>
                                <td style="border: 1px solid #ccc; padding: 5px; text-align: right;"><span t-field="vo.reason"/></td>
                                <td style="border: 1px solid #ccc; padding: 5px; font-weight: bold;"><span t-field="vo.total_revenue_change" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                <td style="border: 1px solid #ccc; padding: 5px;">
                                    <span t-if="vo.state == 'client_approved'" style="color: #5cb85c; font-weight: bold;">معتمد ومصادق</span>
                                    <span t-elif="vo.state == 'engineer_approved'" style="color: #0275d8;">موافقة المهندس المقيم</span>
                                    <span t-elif="vo.state == 'submitted'" style="color: #f0ad4e;">مقدم للاعتماد</span>
                                    <span t-elif="vo.state == 'rejected'" style="color: #d9534f;">مرفوض</span>
                                    <span t-else="" style="color: #777;">مسودة</span>
                                </td>
                            </tr>
                            <tr style="background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                <td colspan="5" style="border: 1px solid #999; padding: 6px; text-align: left;">صافي أوامر الغيار المصادق عليها رسمياً:</td>
                                <td style="border: 1px solid #999; padding: 6px; color: #5cb85c;"><span t-field="o.vo_total_revenue" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                <td style="border: 1px solid #999; padding: 6px;">-</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Official Signatures -->
                    <div style="margin-top: 30px; page-break-inside: avoid; border-top: 1px solid #999; padding-top: 10px;">
                        <table style="width: 100%; text-align: center; font-size: 11px;">
                            <tr>
                                <td style="width: 33%;">
                                    <p style="font-weight: bold; margin-bottom: 40px;">المهندس المقيم المشرف</p>
                                    <p style="margin: 0;">التوقيع: ..........................</p>
                                </td>
                                <td style="width: 33%;">
                                    <p style="font-weight: bold; margin-bottom: 40px;">مدير دائرة العقود والمشاريع</p>
                                    <p style="margin: 0;">التوقيع: ..........................</p>
                                </td>
                                <td style="width: 33%;">
                                    <p style="font-weight: bold; margin-bottom: 40px;">مصادقة رب العمل / المدير المفوض</p>
                                    <p style="margin: 0;">التوقيع: ..........................</p>
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
