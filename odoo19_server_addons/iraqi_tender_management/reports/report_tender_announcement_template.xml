<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_tender_announcement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" dir="rtl" style="font-family: 'Cairo', 'DejaVu Sans', sans-serif; font-size: 13px;">
                        <div class="text-center mb-4 pb-2 border-bottom">
                            <h2 style="color: #1a365d; font-weight: bold;"><span t-field="doc.company_id.name"/></h2>
                            <h3 style="color: #2b6cb0; font-weight: bold;">استمارة دراسة وتسعير العطاء وجدول الكميات</h3>
                            <div class="d-flex justify-content-between mt-2">
                                <span><strong>رمز المشاركة: </strong><span t-field="doc.name"/></span>
                                <span><strong>رقم المناقصة الرسمي: </strong><span t-field="doc.tender_number"/></span>
                                <span><strong>أسلوب التعاقد: </strong><span t-field="doc.tender_type"/></span>
                            </div>
                        </div>

                        <!-- Details Grid -->
                        <table class="table table-bordered table-sm mb-4">
                            <tbody>
                                <tr>
                                    <td style="width: 20%; background-color: #edf2f7;"><strong>الجهة المعلنة / المستفيدة:</strong></td>
                                    <td style="width: 30%;"><span t-field="doc.beneficiary_id.name"/></td>
                                    <td style="width: 20%; background-color: #edf2f7;"><strong>مهندس التسعير المسؤول:</strong></td>
                                    <td style="width: 30%;"><span t-field="doc.responsible_user_id.name"/></td>
                                </tr>
                                <tr>
                                    <td style="background-color: #edf2f7;"><strong>موضوع المناقصة:</strong></td>
                                    <td colspan="3"><span t-field="doc.tender_title"/></td>
                                </tr>
                                <tr>
                                    <td style="background-color: #edf2f7;"><strong>تاريخ الشراء والاستلام:</strong></td>
                                    <td><span t-field="doc.purchase_date"/></td>
                                    <td style="background-color: #edf2f7;"><strong>آخر موعد لتقديم العطاء:</strong></td>
                                    <td><span t-field="doc.submission_deadline"/></td>
                                </tr>
                                <tr>
                                    <td style="background-color: #edf2f7;"><strong>الكلفة التقديرية الداخلية:</strong></td>
                                    <td style="font-weight: bold; color: #4a5568;">
                                        <span t-field="doc.total_estimated_cost" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td style="background-color: #edf2f7;"><strong>مبلغ العطاء المقدم:</strong></td>
                                    <td style="font-weight: bold; color: #2b6cb0;">
                                        <span t-field="doc.total_bid_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="background-color: #edf2f7;"><strong>هامش الربح المتوقع:</strong></td>
                                    <td style="font-weight: bold; color: #38a169;">
                                        <span t-field="doc.expected_profit_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/> (<span t-field="doc.expected_profit_margin"/>%)
                                    </td>
                                    <td style="background-color: #edf2f7;"><strong>كفالة الدخول المطلوبة (1%):</strong></td>
                                    <td style="font-weight: bold; color: #c53030;">
                                        <span t-field="doc.required_bid_bond" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Line Items -->
                        <h4 style="color: #2b6cb0; border-bottom: 2px solid #2b6cb0; padding-bottom: 5px;">
                            جدول المواد والكميات والتسعير (BOQ Pricing)
                        </h4>
                        <table class="table table-bordered table-striped table-sm text-center mt-2">
                            <thead style="background-color: #2b6cb0; color: white;">
                                <tr>
                                    <th style="width: 5%;">ت</th>
                                    <th style="width: 40%;">بيان المادة والمواصفات الفنية</th>
                                    <th style="width: 10%;">الكمية</th>
                                    <th style="width: 10%;">الوحدة</th>
                                    <th style="width: 15%;">سعر الوحدة المقدم</th>
                                    <th style="width: 20%;">إجمالي البند في العطاء</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="1"/>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><t t-esc="idx"/></td>
                                    <td class="text-end"><span t-field="line.name"/></td>
                                    <td><span t-field="line.quantity"/></td>
                                    <td><span t-field="line.uom_id.name"/></td>
                                    <td><span t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    <td style="font-weight: bold;"><span t-field="line.subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                    <t t-set="idx" t-value="idx + 1"/>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Guarantee Info -->
                        <div class="mt-4 p-3 border rounded bg-light">
                            <strong>بيانات كفالة دخول المناقصة (Bid Bond):</strong>
                            <div class="row mt-2">
                                <div class="col-4"><strong>رقم الكفالة: </strong><span t-field="doc.bid_bond_number"/></div>
                                <div class="col-4"><strong>المصرف الضامن: </strong><span t-field="doc.bid_bond_bank"/></div>
                                <div class="col-4"><strong>تاريخ النفاذ: </strong><span t-field="doc.bid_bond_expiry_date"/></div>
                            </div>
                        </div>

                        <!-- Signatures -->
                        <div class="row mt-5 text-center">
                            <div class="col-6">
                                <strong>مهندس التسعير وإعداد العطاء</strong><br/><br/>
                                <span>....................................</span>
                            </div>
                            <div class="col-6">
                                <strong>مدير قسم العطاءات والمناقصات</strong><br/><br/>
                                <span>....................................</span>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
